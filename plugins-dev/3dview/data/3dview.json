{
  "version": 1,
  "time": "timestamp",
  "sampleRate": 100.0,
  "units": {
    "position": "mm",
    "angle": "deg",
    "time": "s"
  },
  "joint": {
    "actual_joint": [
      { "name": "actual_joint_1", "type": "revolute" },
      { "name": "actual_joint_2", "type": "revolute" },
      { "name": "actual_joint_3", "type": "prismatic" }
    ],
    "command_joint": [
      { "name": "command_joint_1", "type": "revolute" },
      { "name": "command_joint_2", "type": "revolute" },
      { "name": "command_joint_3", "type": "prismatic" }
    ]
  },
  "tcp": {
    "actual_tcp": ["x", "y", "z", "rx", "ry", "rz"],
    "command_tcp": ["cmd_x", "cmd_y", "cmd_z", "cmd_rx", "cmd_ry", "cmd_rz"]
  },
  "presets": {
    "actual": {
      "joint": "actual_joint",
      "tcp": ["actual_tcp"],
      "pose": "actual_tcp"
    },
    "compare": {
      "joint": "actual_joint",
      "tcp": ["actual_tcp", "command_tcp"],
      "pose": "actual_tcp"
    }
  },
  "defaultPreset": "compare"
}
